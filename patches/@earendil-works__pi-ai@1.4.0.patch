+++ b/dist/utils/local-request-stream.js
@@ -0,0 +1,25 @@
+import { AssistantMessageEventStream } from "./event-stream.js";
+import { asLocalRequestError, localRequestErrorDetails } from "./local-request-error.js";
+export function withLocalRequestErrors(model, options, prepare) {
+    try {
+        return prepare();
+    }
+    catch (error) {
+        // Only synchronous setup/buildBaseOptions is wrapped; network and response
+        // parsing stay with the adapter's own error handling.
+        const details = localRequestErrorDetails(asLocalRequestError(error, "request-preparation"));
+        const aborted = options?.signal?.aborted === true;
+        const message = {
+            role: "assistant", content: [], api: model.api, provider: model.provider, model: model.id,
+            usage: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, totalTokens: 0,
+                cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } },
+            stopReason: aborted ? "aborted" : "error", timestamp: Date.now(),
+            errorMessage: aborted ? "Request was aborted" : details.message,
+            ...(aborted ? {} : { errorDetails: details }),
+        };
+        const stream = new AssistantMessageEventStream();
+        stream.push({ type: "error", reason: message.stopReason, error: message });
+        stream.end();
+        return stream;
+    }
+}

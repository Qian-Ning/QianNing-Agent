+export type LocalRequestErrorPhase = "context-validation" | "context-estimation" | "request-preparation";
+export interface LocalRequestErrorDetails {
+    code: "LOCAL_REQUEST_ERROR";
+    phase: LocalRequestErrorPhase;
+    message: string;
+    causeName?: string;
+}
+export declare class LocalRequestError extends Error {
+    readonly code: "LOCAL_REQUEST_ERROR";
+    readonly phase: LocalRequestErrorPhase;
+    constructor(phase: LocalRequestErrorPhase, options?: ErrorOptions);
+}
+export declare function localRequestErrorDetails(error: unknown): LocalRequestErrorDetails | undefined;
+export declare function asLocalRequestError(error: unknown, phase: LocalRequestErrorPhase): unknown;
+export declare function prepareLocalRequest<T>(phase: LocalRequestErrorPhase, prepare: () => T): T;
